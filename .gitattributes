# Auto detect text files and perform LF normalization
* text=auto

# Rust files always use LF
*.rs text eol=lf
*.toml text eol=lf
*.lock text eol=lf

# Shell scripts
*.sh text eol=lf
*.ps1 text eol=lf

# Web files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf

# Binary
*.png binary
*.ico binary
*.icns binary
*.db binary