{
  "identifier": "default",
  "description": "Default capabilities for the panel webview only; the remote maps webview has its own minimal capability",
  "windows": ["main"],
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-emit",
    "core:event:allow-listen",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    }
  ]
}
